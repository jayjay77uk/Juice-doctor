# ─────────────────────────────────────────────────────────────────────────────
# Prototype AI — environment
#
# Copy to `.env.local` (gitignored) and fill in. Secrets are server-only and
# must never be committed. The app degrades to an honest "unavailable" state
# when a provider is not configured — it never fabricates AI answers or data.
# ─────────────────────────────────────────────────────────────────────────────

# Cosmetic UI flag — drives the "Prototype Environment" banner only.
# Public (client-visible) by design. Never gate secrets on this.
#   values: "prototype" | "production"
NEXT_PUBLIC_APP_MODE=prototype
APP_MODE=prototype

# ── Supabase (database, auth, storage) ───────────────────────────────────────
# Project URL + anon key are PUBLIC (safe in the browser). The service-role key
# is SERVER-ONLY (bypasses RLS) — never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management token (sbp_…) — tooling only (migrations / key management), NOT a runtime key.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ── AI provider (server-only) ────────────────────────────────────────────────
# HERNE specialist reasoning + receptionist. Without ANTHROPIC_API_KEY, AI
# features show an honest "AI unavailable" state (never fabricated answers).
# The key is SERVER-ONLY — it is never exposed to the browser.
ANTHROPIC_API_KEY=

# Which provider to use. Only "anthropic" is implemented; the abstraction lets
# another be added without rewriting the HERNE orchestration engine.
AI_PROVIDER=anthropic
# Default model (preferred over the legacy AI_MODEL).
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
# AI_MODEL=claude-sonnet-5   # legacy fallback, still honoured

# ── AI limits & behaviour (server-side) ──────────────────────────────────────
# Guardrails on every live call + per-user prototype usage limits.
AI_MAX_INPUT_TOKENS=14000
AI_MAX_OUTPUT_TOKENS=1024
# Request timeout: milliseconds (>=1000) or seconds (<1000, scaled up).
AI_REQUEST_TIMEOUT=60000
AI_DAILY_USER_LIMIT=50
AI_MONTHLY_USER_LIMIT=500
# Prototype mode ON = extra safety wording + simulated-data notices. Keep true
# until a live clinical deployment is separately approved.
AI_PROTOTYPE_MODE=true

# ── Optional providers ───────────────────────────────────────────────────────
# Vector embeddings for RAG. Anthropic has NO embeddings API — set one of these
# for vector search; otherwise retrieval falls back to Postgres full-text search.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# Audio/video transcription (Whisper). Without it, audio/video ingestion is
# blocked (image understanding still works via Claude vision).
# (uses OPENAI_API_KEY above)

# Base URL for auth redirects (defaults to http://localhost:3011).
# NEXT_PUBLIC_SITE_URL=
